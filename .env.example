# .env.local にコピーして利用。本番は Vercel の Environment Variables に同様に設定。

# --- 公開サイト URL（本番は必須・末尾スラッシュなし）---
# 例: https://chonburihome.com ／ ローカル: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# 任意（NEXT_PUBLIC_SITE_URL と同じでよい場合は未設定で可）
# NEXT_PUBLIC_BASE_URL=

# --- Supabase（Next.js クライアント・サーバー）---
# 本番（または「開発用ホスト」以外の既定接続先）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase（開発ホスト専用・任意）---
# リクエストの Host が localhost / 127.0.0.1 / dev.chonburihome.com のとき、
# 下記が揃っていれば開発用プロジェクトに接続します（README の「環境の切り替え」参照）。
# NEXT_PUBLIC_SUPABASE_URL_DEV=
# NEXT_PUBLIC_SUPABASE_ANON_KEY_DEV=
# SUPABASE_SERVICE_ROLE_KEY_DEV=

# --- Stripe ---
# 秘密鍵: ローカル検証は sk_test_…、本番（Vercel Production 等）は sk_live_…。ここには実値を書かない。
STRIPE_SECRET_KEY=
# Webhook 署名検証用。テスト用エンドポイントと本番エンドポイントで whsec_ は別物。Dashboard（テスト／本番モード）で
# https://<ドメイン>/api/webhook を登録し、checkout.session.completed 等を購読したうえで Signing secret をコピーする。
STRIPE_WEBHOOK_SECRET=
# 公開鍵: テストは pk_test_…、本番は pk_live_…
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# 料金ページの Checkout は既定でコード内の Pro・USD（$160/月・$1,600/年）を使用。
# ダッシュボードの Price ID で課金する場合のみ true にし、月額・年額の Price ID も設定する。
# STRIPE_CHECKOUT_USE_CATALOG_PRICES=true
# STRIPE_PRICE_ID_MONTHLY=
# STRIPE_PRICE_ID_YEARLY=
# NEXT_PUBLIC_STRIPE_PRICE_ID_MONTHLY=
# NEXT_PUBLIC_STRIPE_PRICE_ID_YEARLY=

# --- メール（問い合わせ通知など）---
RESEND_API_KEY=

# --- Google Maps ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_SERVER_KEY=

# --- 旧ドメインからの 308（カンマ区切りホスト名。未設定なら追加しない）---
# LEGACY_REDIRECT_HOSTS=old-project.vercel.app

# --- Supabase Edge Functions（Dashboard の Secrets に設定）---
# 関数によっては SITE_URL / NEXT_PUBLIC_SITE_URL と同じ公開オリジンが必要です。
# SITE_URL=https://chonburihome.com
#
# --- 廃止済み（アプリ・本リポジトリの Edge 実装では未使用。Vercel / .env.local に残っていれば削除可）---
# NEXT_PUBLIC_LINE_LIFF_ID / NEXT_PUBLIC_LINE_LIFF_ID_DEV
# LINE_OFFICIAL_CHANNEL_SECRET / LINE_OFFICIAL_CHANNEL_ACCESS_TOKEN（および *_DEV）
# LINE_CHANNEL_ID / LINE_CHANNEL_SECRET / LINE_CHANNEL_ACCESS_TOKEN
# LINE_INQUIRY_THANK_YOU_MESSAGE（旧 Push 用）

# --- LINE ログイン（マイページの「LINE連携」＝ Supabase Custom OAuth）---
# Supabase には組み込み provider `line` がないため、Dashboard で Custom プロバイダーを作成する。
# 識別子を custom:line にした場合は未設定でよい。別名にしたらここを同じ文字列にする。
# NEXT_PUBLIC_SUPABASE_LINE_PROVIDER=custom:line

# --- 公式LINE（URL ベース: 友だち追加・oaMessage 起動。Messaging API は使わない）---
# 友だち追加 URL / Basic ID / Manager URL の開発用オーバーライド（任意）
# NEXT_PUBLIC_OFFICIAL_LINE_ADD_URL_DEV=
# NEXT_PUBLIC_LINE_OFFICIAL_ID_DEV=
# NEXT_PUBLIC_LINE_OFFICIAL_MANAGER_CHAT_URL_DEV=

# 任意。ダッシュボード「LINE連携の設定」で表示する「運営代行・お問い合わせ」ボタンの URL（未設定時は友だち追加 URL にフォールバック）
# NEXT_PUBLIC_OPERATIONS_SUPPORT_LINE_URL=

# 友だち追加URL（本番は公式アカウントのものを指定）
# NEXT_PUBLIC_OFFICIAL_LINE_ADD_URL=https://line.me/R/ti/p/@（LINEのBasic ID）
# または NEXT_PUBLIC_LINE_OFFICIAL_ID=@example

# ダッシュボード「チャット管理を開く」の遷移先（任意・全文 URL）
# 未設定時は Basic ID から manager.line.biz のアカウントホームを組み立てます。
# NEXT_PUBLIC_LINE_OFFICIAL_MANAGER_CHAT_URL=https://manager.line.biz/account/@あなたのBasicID/

# --- Twilio WhatsApp（B2B エージェント通知）---
# 「From」は承認済み WhatsApp Sender。サンドボックス例は whatsapp:+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
#
# POST /api/whatsapp/send の Bearer。未設定でも SUPABASE_SERVICE_ROLE_KEY と同じトークンで呼べます（権限強いので本番は専用推奨）
WHATSAPP_SEND_API_SECRET=
# Supabase Database Webhooks の Authorization Bearer
WHATSAPP_WEBHOOK_SECRET=
# true のときのみ、別エージェントへ簡易マッチング通知（送信量・スパムに注意）
# WHATSAPP_NOTIFY_MATCHING_AGENTS=false
