# .env.local にコピーして利用。本番は Vercel の Environment Variables に同様に設定。

# --- 公開サイト URL（本番は必須・末尾スラッシュなし）---
# 例: https://chonburihome.com ／ ローカル: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# 任意（NEXT_PUBLIC_SITE_URL と同じでよい場合は未設定で可）
# NEXT_PUBLIC_BASE_URL=

# --- Supabase（Next.js クライアント・サーバー）---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- メール（問い合わせ通知など）---
RESEND_API_KEY=

# --- Google Maps ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_SERVER_KEY=

# --- 旧ドメインからの 308（カンマ区切りホスト名。未設定なら追加しない）---
# LEGACY_REDIRECT_HOSTS=old-project.vercel.app

# --- Supabase Edge Functions（Dashboard の Secrets に設定）---
# NEXT_PUBLIC_SITE_URL と同じ公開オリジン、または SITE_URL としても可
# SITE_URL=https://chonburihome.com
# LINE_CHANNEL_ACCESS_TOKEN=（Messaging API チャネルアクセストークン）
# LINE_CHANNEL_ID / LINE_CHANNEL_SECRET は Next アプリでは未使用（LINE ログイン未導入）

# --- LINE ログイン（マイページ通知の「LINE連携」＝ Supabase Custom OAuth）---
# Supabase には組み込み provider `line` がないため、Dashboard で Custom プロバイダーを作成する。
# 識別子を custom:line にした場合は未設定でよい。別名にしたらここを同じ文字列にする。
# NEXT_PUBLIC_SUPABASE_LINE_PROVIDER=custom:line

# --- 公式LINE 問い合わせルーティング（Messaging API。両方セットで物件ページは公式LINEフローに切り替わる）---
# LINE Developers → Messaging API → Webhook URL: https://YOUR_DOMAIN/api/webhooks/line-official （検証OKをON）
# チャネルシークレット・アクセストークンは「公式アカウント用」チャネルと一致させること
# LINE_OFFICIAL_CHANNEL_SECRET=
# LINE_OFFICIAL_CHANNEL_ACCESS_TOKEN=
# 物件お問い合わせフォームで「LINEで受け取る」を選んだとき、送信確定時に LIFF で line_user_id を取得
# NEXT_PUBLIC_LINE_LIFF_ID=
# 任意: 問い合わせ後にユーザーへ送る Push 文（未設定時はデフォルト文言）
# LINE_INQUIRY_THANK_YOU_MESSAGE=

# 友だち追加URLは NEXT_PUBLIC_OFFICIAL_LINE_ADD_URL または NEXT_PUBLIC_LINE_OFFICIAL_ID（src/lib/line-official.ts）
# 任意: Webhook 返信文の上書き（日本語デフォルトあり）
# LINE_OFFICIAL_WEBHOOK_FOLLOW_MESSAGE=
# LINE_OFFICIAL_WEBHOOK_UNKNOWN_MESSAGE=
# LINE_OFFICIAL_WEBHOOK_BAD_NONCE=
# LINE_OFFICIAL_WEBHOOK_EXPIRED_NONCE=
# LINE_OFFICIAL_WEBHOOK_BOUND_OK=
